#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$root"
bin="${XDG_CACHE_HOME:-$HOME/.cache}/gh-patch/gh-patch"
stamp_file="${bin}.stamp"
stamp=$(git rev-parse HEAD 2>/dev/null || find cmd internal go.mod -type f -print | sort | xargs shasum -a 256 | shasum -a 256)

if [ ! -x "$bin" ] || [ ! -f "$stamp_file" ] || [ "$(cat "$stamp_file")" != "$stamp" ]; then
  mkdir -p "$(dirname -- "$bin")"
  go build -o "$bin" ./cmd/gh-patch
  printf '%s\n' "$stamp" > "$stamp_file"
fi

exec "$bin" "$@"
